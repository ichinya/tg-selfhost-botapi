ARG PYTHON_IMAGE=python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY tools/file_access.py tools/file_contract.py tools/download_server.py /app/tools/
COPY examples/files/local_reader.py /app/examples/files/local_reader.py
USER 101:101
EXPOSE 8083
ENTRYPOINT ["python", "-m", "tools.download_server"]
