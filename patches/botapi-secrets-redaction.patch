diff --git a/telegram-bot-api/PrivacyLog.h b/telegram-bot-api/PrivacyLog.h
new file mode 100644
--- /dev/null
+++ b/telegram-bot-api/PrivacyLog.h
@@ -0,0 +1,17 @@
+// Log-only privacy projection. HTTP requests and private state are unchanged.
+#pragma once
+#include "td/utils/logging.h"
+namespace telegram_bot_api {
+class PrivacyLog final : public td::LogInterface {
+ public:
+  explicit PrivacyLog(td::LogInterface *sink) : sink_(sink) {}
+  void set_sink(td::LogInterface *sink) { sink_ = sink; }
+  void do_append(int level, td::CSlice) final {
+    // Discard before file/memory sinks, including TDLib and reflected errors.
+    sink_->do_append(level, level <= 1 ? "botapi_event severity=error\n" : "botapi_event severity=event\n");
+  }
+  void after_rotation() final { sink_->after_rotation(); }
+ private:
+  td::LogInterface *sink_;
+};
+}  // namespace telegram_bot_api
