API_ID=3000...
API_HASH=2f30f...

# Set to 0.0.0.0 only when the gateway must be reachable externally.
# GATEWAY_BIND=0.0.0.0

# Optional migration helper settings (use a trusted shell-compatible file).
# SELF_BOT_URL=http://127.0.0.1:18080
# WEBHOOK_URL=https://example.com/telegram/webhook
# DROP_PENDING_UPDATES=false

# Optional: pin a tested published build or digest instead of latest.
# BOTAPI_IMAGE=ghcr.io/ichinya/tg-selfhost-botapi:build-<key>
# Host-side migration helper only; see docs/en/configuration.md and docs/ru/configuration.md.
# MIGRATION_CONNECT_TIMEOUT=5
# MIGRATION_REQUEST_DEADLINE=30

# Monitoring: keep the management ingress private. Pin both images to the same key.
TELEGRAM_STAT=false
# TELEGRAM_HTTP_IP_ADDRESS=0.0.0.0
# TELEGRAM_HTTP_PORT=8081
# MGMT_BIND=127.0.0.1
# OBSERVER_IMAGE=ghcr.io/ichinya/tg-selfhost-botapi:observer-build-<key>
# Optional local observer base override must be an immutable image reference.
# OBSERVER_BASE=python:3.13.5-alpine3.22@sha256:<digest>
# OBSERVER_MIGRATION_DIR=/inputs/migration
# OBSERVER_REGISTRY=/inputs/registry/registry.json
# Host inputs: .observability/{runtime,migration,registry,credentials}
# MIGRATION_STATUS_DIR and MIGRATION_STATUS_ALIAS are process environment only.
