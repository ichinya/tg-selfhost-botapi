API_ID=12345
API_HASH=replace-api-hash

# Set to 0.0.0.0 only when the gateway must be reachable externally.
# GATEWAY_BIND=0.0.0.0

# Optional migration helper settings (use a trusted shell-compatible file).
# SELF_BOT_URL=http://127.0.0.1:18080
# WEBHOOK_URL=https://example.com/telegram/webhook
# DROP_PENDING_UPDATES=false

# Optional: pin a tested published build or digest instead of latest.
# BOTAPI_IMAGE=ghcr.io/ichinya/tg-selfhost-botapi:build-<key>

# Migration inputs; keep real values in a private file (0600), outside Git.
# BOT_TOKEN_FILE=/home/operator/private/bot-token
# OLD_BOT_URL=https://api.telegram.org
# SELF_BOT_URL=http://bot-api.internal:8081
# MIGRATION_ACTION=polling
# MIGRATION_DIRECTION=cloud_to_local
# MIGRATION_LOCAL_MODE=true
# MIGRATION_STATE_DIR=/home/operator/.local/state/tg-selfhost-botapi/migrations
# MIGRATION_EVIDENCE_FILE=/home/operator/private/deployment.json
# MIGRATION_TRUST_FILE=/home/operator/private/providers.json
