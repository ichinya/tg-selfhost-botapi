API_ID=12345
API_HASH=replace-api-hash

# Optional non-root Compose override; prepare both absolute paths first.
# BOTAPI_UID=1000
# BOTAPI_GID=1000
# BOTAPI_STATE_SOURCE=/srv/botapi/data
# BOTAPI_TEMP_SOURCE=/srv/botapi/scratch
# Optional media override, used with the non-root override; separate prepared root.
# BOTAPI_MEDIA_SOURCE=/srv/botapi/media
# Optional Compose secrets overlay: host paths outside this checkout.
# TELEGRAM_API_ID_SECRET_PATH=/secure/telegram-api-id
# TELEGRAM_API_HASH_SECRET_PATH=/secure/telegram-api-hash

# Set to 0.0.0.0 only when the gateway must be reachable externally.
# GATEWAY_BIND=0.0.0.0

# Optional migration helper settings (use a trusted shell-compatible file).
# SELF_BOT_URL=http://127.0.0.1:18080
# WEBHOOK_URL=https://example.com/telegram/webhook
# DROP_PENDING_UPDATES=false

# Registry deployment: use all immutable refs from a qualified release receipt.
# Compose config falls back to local tags; absent local images make base up fail on pull.
# Local builds use generated .env.build; set a qualified gateway ref separately.
# No accepted release is selected in image-release.lock.json yet.
# BOTAPI_IMAGE=ghcr.io/ichinya/tg-selfhost-botapi@sha256:<qualified-digest>
# OBSERVER_IMAGE=ghcr.io/ichinya/tg-selfhost-botapi-observer@sha256:<qualified-observer-digest>
# GATEWAY_IMAGE=nginx:alpine@sha256:<qualified-gateway-digest>
# DOWNLOADS_IMAGE=ghcr.io/ichinya/tg-selfhost-botapi-downloads@sha256:<qualified-downloads-digest>

# Host migration helper; protected inputs outside checkout/webroot.
# WEBHOOK_SECRET_MODE=provided
# WEBHOOK_SECRET_TOKEN_FILE=/secure/previous-webhook-secret
# WEBHOOK_IP_MODE=dns
# WEBHOOK_ALLOWED_UPDATES=[]
# WEBHOOK_MAX_CONNECTIONS=40
# WEBHOOK_TARGET_LOCAL=false
# WEBHOOK_CERTIFICATE_MODE=none
# WEBHOOK_CERTIFICATE_FILE=/secure/public-certificate.pem
# BOT_TOKEN_FILE=/secure/bot-token
# TELEGRAM_VERBOSITY=0

# Host-side migration helper only; see docs/en/configuration.md and docs/ru/configuration.md.
# MIGRATION_CONNECT_TIMEOUT=5
# MIGRATION_REQUEST_DEADLINE=30

# Monitoring: keep the management ingress private. Pin both images to the same key.
TELEGRAM_STAT=false
# TELEGRAM_HTTP_IP_ADDRESS=0.0.0.0
# TELEGRAM_HTTP_PORT=8081
# MGMT_BIND=127.0.0.1
# OBSERVER_IMAGE=ghcr.io/ichinya/tg-selfhost-botapi-observer:observer-build-<key>
# Optional local observer base override must be an immutable image reference.
# OBSERVER_BASE=python:3.13.5-alpine3.22@sha256:<digest>
# OBSERVER_MIGRATION_DIR=/inputs/migration
# OBSERVER_REGISTRY=/inputs/registry/registry.json
# Host inputs: .observability/{runtime,migration,registry,credentials}
# MIGRATION_STATUS_DIR and MIGRATION_STATUS_ALIAS are process environment only.

# Split storage is enabled by docker-compose.files.yml, not by .env alone.
# TELEGRAM_FILES_DIR, TELEGRAM_WORK_DIR, TELEGRAM_TEMP_DIR, TELEGRAM_LOG_FILE

# Optional per-bot reader/downloads: qualified DOWNLOADS_IMAGE; BOT_A_ROOT;
# BOT_A_HOST_ROOT; BOT_TOKEN_FILE; DOWNLOAD_BOT_TOKEN_FILE; DOWNLOAD_AUTH_TOKEN_FILE.
# DOWNLOADS_BIND; DOWNLOAD_MAX_DURATION; DOWNLOAD_WORKERS; BOT_TEST_DC; BOT_COLON_LAYOUT.
