API_ID=12345
API_HASH=replace-api-hash

# Optional non-root Compose override; prepare both absolute paths first.
# BOTAPI_UID=1000
# BOTAPI_GID=1000
# BOTAPI_STATE_SOURCE=/srv/botapi/data
# BOTAPI_TEMP_SOURCE=/srv/botapi/scratch
# Optional media override, used with the non-root override; separate prepared root.
# BOTAPI_MEDIA_SOURCE=/srv/botapi/media

# Set to 0.0.0.0 only when the gateway must be reachable externally.
# GATEWAY_BIND=0.0.0.0

# Optional migration helper settings (use a trusted shell-compatible file).
# SELF_BOT_URL=http://127.0.0.1:18080
# WEBHOOK_URL=https://example.com/telegram/webhook
# DROP_PENDING_UPDATES=false

# Optional: pin a tested published build or digest instead of latest.
# BOTAPI_IMAGE=ghcr.io/ichinya/tg-selfhost-botapi:build-<key>

# Host migration helper; protected inputs outside checkout/webroot.
# WEBHOOK_SECRET_MODE=provided
# WEBHOOK_SECRET_TOKEN_FILE=/secure/previous-webhook-secret
# WEBHOOK_IP_MODE=dns
# WEBHOOK_ALLOWED_UPDATES=[]
# WEBHOOK_MAX_CONNECTIONS=40
# WEBHOOK_TARGET_LOCAL=false
# WEBHOOK_CERTIFICATE_MODE=none
# WEBHOOK_CERTIFICATE_FILE=/secure/public-certificate.pem
# BOT_TOKEN_FILE=/secure/bot-token

# Host-side migration helper only; see docs/en/configuration.md and docs/ru/configuration.md.
# MIGRATION_CONNECT_TIMEOUT=5
# MIGRATION_REQUEST_DEADLINE=30
